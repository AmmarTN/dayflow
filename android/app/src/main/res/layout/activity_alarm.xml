<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/alarm_screen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="36dp"
        android:paddingEnd="28dp"
        android:paddingBottom="36dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.16" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/alarm_surface_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="34dp"
            android:paddingEnd="24dp"
            android:paddingBottom="30dp">

            <FrameLayout
                android:layout_width="132dp"
                android:layout_height="132dp">

                <View
                    android:id="@+id/pulseRingOuter"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:alpha="0.28"
                    android:background="@drawable/alarm_pulse_ring_soft" />

                <View
                    android:id="@+id/pulseRing"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:alpha="0.64"
                    android:background="@drawable/alarm_pulse_ring" />

                <View
                    android:id="@+id/iconHalo"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:background="@drawable/alarm_icon_core" />

                <ImageView
                    android:id="@+id/alarmIcon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_lock_idle_alarm"
                    android:tint="@color/dayflow_accent_green" />
            </FrameLayout>

            <TextView
                android:id="@+id/alarmLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.28"
                android:text="@string/alarm_task_reminder"
                android:textAllCaps="true"
                android:textColor="@color/dayflow_accent_green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/alarmTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:maxLines="3"
                android:textColor="@color/dayflow_dark_text_primary"
                android:textSize="31sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/alarmSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:maxLines="3"
                android:textColor="@color/dayflow_dark_text_secondary"
                android:textSize="15.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/alarmTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/alarm_time_chip"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp"
                android:paddingBottom="10dp"
                android:textColor="@color/dayflow_accent_green_bright"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/markDoneButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/alarm_primary_button"
            android:elevation="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/alarm_mark_done"
            android:textAllCaps="false"
            android:textColor="@color/dayflow_dark_background"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/snoozeButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/alarm_secondary_button"
            android:elevation="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/alarm_snooze_10_min"
            android:textAllCaps="false"
            android:textColor="@color/dayflow_accent_green_bright"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dismissButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/alarm_dismiss_chip"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/alarm_dismiss"
            android:textColor="@color/dayflow_dark_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
